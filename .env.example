# Build-time variables (Netlify > Site configuration > Environment variables).
# Production origin for canonical URLs, sitemap, robots, Open Graph, JSON-LD.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://girlontherun.com

# Google Search Console HTML-tag verification `content` value. Leave unset
# to render no tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
